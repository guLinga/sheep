<%- partial('_partial/header',{name:'library'}) %>
<% var book = page.book %>
<% var coverSrc = book.cover || theme.default_cover %>
<div class="home library-page library-page--weread library-book-page">
  <%- partial('_widget/header_body',{message:theme.headers.home.message,icon:theme.headers.home.icon}) %>
  <div class="main library-main">
    <div class="library-weread">
      <div class="library-weread-top">
        <div class="library-weread-inner">
          <nav class="library-weread-subnav" aria-label="图书馆导航">
            <a href="<%= url_for('/library/') %>" class="library-weread-nav-back">← 图书馆</a>
          </nav>
        </div>
      </div>

      <div class="library-weread-body">
        <div class="library-weread-inner">
          <header class="library-book-hero" id="content">
            <div class="library-book-cover-wrap">
              <img class="library-book-cover" src="<%= coverSrc %>" alt="<%= book.name %>" loading="lazy" />
            </div>
            <div class="library-book-meta">
              <h1 class="library-book-title"><%= book.name %></h1>
              <% if (book.author) { %>
              <p class="library-book-author"><%= book.author %></p>
              <% } %>
              <% if (page.introHtml) { %>
              <div class="library-book-intro library-md-content"><%- page.introHtml %></div>
              <% } %>
              <% if (book.readUrl) { %>
              <% var ru = String(book.readUrl) %>
              <% var isPdf = /\.pdf(\?|#|$)/i.test(ru.trim()) %>
              <% var rh = isPdf ? url_for('library/book/' + page.bookId + '/read/') : (ru.indexOf('http') === 0 ? ru : url_for(ru)) %>
              <% var ext = !isPdf && ru.indexOf('http') === 0 %>
              <% var pdfDirect = isPdf ? (ru.indexOf('http') === 0 ? ru : url_for(ru)) : '' %>
              <% var pdfDownloadName = ((book.name || 'book').replace(/[\\/:*?"<>|]/g, '_').trim() || 'book') + '.pdf' %>
              <% var pdfDlExt = isPdf && pdfDirect.indexOf('http') === 0 %>
              <div class="library-book-actions">
                <a class="library-read-btn" href="<%= rh %>"<% if (ext) { %> target="_blank" rel="noopener noreferrer"<% } %>>在线阅读</a>
                <% if (isPdf) { %>
                <a class="library-read-btn library-read-btn--download" href="<%= pdfDirect %>" download="<%= pdfDownloadName %>"<% if (pdfDlExt) { %> target="_blank" rel="noopener noreferrer"<% } %>>下载 PDF</a>
                <% } %>
              </div>
              <% } %>
            </div>
          </header>

          <section class="library-reflections">
            <h2 class="library-section-title library-section-title--weread">读书心得</h2>
            <% if (!(page.reflections || []).length) { %>
            <p class="library-reflections-empty">暂无心得：在 <code>source/_library/<%= page.bookId %>/</code> 下除 <code>index.md</code> 外添加其它 <code>.md</code> 文件即可。</p>
            <% } else { %>
            <ul class="library-reflection-list">
              <% page.reflections.forEach(function (note) { %>
              <% if (!note.id) { return } %>
              <li>
                <a class="library-reflection-card" href="<%= url_for('library/book/' + page.bookId + '/note/' + note.id + '/') %>">
                  <span class="library-reflection-card-title"><%= note.title %></span>
                  <span class="library-reflection-card-author"><%= note.author %></span>
                  <% if (note.excerpt) { %>
                  <span class="library-reflection-card-excerpt"><%= note.excerpt %></span>
                  <% } %>
                </a>
              </li>
              <% }) %>
            </ul>
            <% } %>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>
